# ============================================================
# 环境配置模板 — 复制为 .env 并填入你的真实密钥
# 小白讲解：
#   1. 复制这个文件，重命名为 .env
#   2. 把等号右边的占位符替换成你的真实密钥
#   3. .env 文件已在 .gitignore 中排除，不会被上传到GitHub
# ============================================================

# MySQL 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=改成你的数据库用户名
MYSQL_PASSWORD=改成你的数据库密码
MYSQL_DATABASE=sourcing_db

# 智谱 GLM 配置（用于图片识别）
ZHIPU_API_KEY=改成你的智谱API密钥
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL=glm-4v-flash

# MiniMax 配置（用于文本理解/搜索/初筛，OpenAI兼容接口）
# 小白讲解：也可以直接在Windows用户环境变量里配置 MINIMAX_API_KEY 或 minimax
MINIMAX_API_KEY=改成你的MiniMax API密钥（sk-cp-开头）
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# 天眼查 MCP 配置（用于供应商工商信息补全）
TYC_MCP_URL=https://mcp.tianyancha.com/v1
TYC_MCP_AUTH=改成你的天眼查MCP认证token

# 快查365 MCP 配置（英文供应商首选/中文供应商降级，同花顺企业数据引擎）
# 获取地址：https://open.kuaicha365.com/skills/
KUAICHA_MCP_URL=https://bizveris.kuaicha365.com/mcp
KUAICHA_API_KEY=改成你的快查API密钥

# 水滴信用 MCP 配置（用于供应商工商/风险信息补全，替代天眼查）
# 小白讲解：水滴把不同数据维度拆成6个端点，每个端点独立鉴权。
# 如果所有端点用同一个key，可以把下面6个都填同一个值。
# 如果是分端点申请的key，每个填各自的key。
# 获取地址：https://www.shuidi.cn/ 注册后在开放平台申请
SHUIDI_DATA_URL=https://data.shuidi.cn/mcp/
SHUIDI_DATA_KEY=改成你的水滴-工商数据key
SHUIDI_RISK_URL=https://risk.data.shuidi.cn/mcp/
SHUIDI_RISK_KEY=改成你的水滴-风险数据key
SHUIDI_SUPPLIER_URL=https://supplier.data.shuidi.cn/mcp/
SHUIDI_SUPPLIER_KEY=改成你的水滴-供应商数据key
SHUIDI_QC_URL=https://qc.data.shuidi.cn/mcp/
SHUIDI_QC_KEY=改成你的水滴-质控数据key
SHUIDI_BID_URL=https://bid.data.shuidi.cn/mcp/
SHUIDI_BID_KEY=改成你的水滴-招投标数据key
SHUIDI_STI_URL=https://sti.data.shuidi.cn/mcp/
SHUIDI_STI_KEY=改成你的水滴-科创数据key

# 1688 配置（用于供应商搜索 - 官方API方式）
ALI_1688_AK=改成你的1688 AccessKey

# 海关贸易数据 MCP 配置（国际海关进出口数据查询）
TOPEASE_API_KEY=改成你的海关贸易数据key
